<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>WarrantyBee.Shared.Core</PackageId>
    <Authors>Arijit Roy</Authors>
    <Company>WarrantyBee</Company>
    <Description>Foundational logic and common contracts for the WarrantyBee ecosystem.</Description>
    <PackageIcon>logo.png</PackageIcon>
    <Version>1.0.1</Version>
    <RepositoryUrl>https://github.com/WarrantyBee/WarrantyBee.Shared</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

</Project>
