<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>WarrantyBee.Shared.Security</PackageId>
    <Authors>Arijit Roy</Authors>
    <Company>WarrantyBee</Company>
    <Description>Unified security protocols and authentication layers for the WarrantyBee ecosystem.</Description>
    <PackageIcon>logo.png</PackageIcon>
    <Version>1.0.5</Version>
    <RepositoryUrl>https://github.com/WarrantyBee/WarrantyBee.Shared</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WarrantyBee.Core\WarrantyBee.Core.csproj" />
    <ProjectReference Include="..\WarrantyBee.Infrastructure\WarrantyBee.Infrastructure.csproj" />
  </ItemGroup>

</Project>
